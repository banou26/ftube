{
  "name": "@banou/ftube",
  "version": "0.0.27",
  "description": "Fast, private YouTube client running in your browser over FKN.",
  "license": "MIT",
  "homepage": "https://youtube.fkn.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banou26/ftube.git"
  },
  "keywords": [
    "fkn",
    "fkn-type:app",
    "youtube",
    "video",
    "ftube"
  ],
  "fkn": {
    "app": "fkn:app:17w6qu6cmzioxe4rcja53gvopyfy4673ti3ljucedts57kumfzzoq",
    "signed": true,
    "url": "https://youtube.fkn.app/",
    "network": [
      "www.youtube.com",
      "*.youtube.com",
      "*.googlevideo.com",
      "*.ytimg.com",
      "*.ggpht.com",
      "*.googleusercontent.com",
      "*.gstatic.com",
      "www.google.com",
      "youtubei.googleapis.com",
      "jnn-pa.googleapis.com",
      "returnyoutubedislikeapi.com",
      "sponsor.ajay.app"
    ],
    "background": "store/background.webp",
    "cover": "store/cover.webp",
    "screenshots": [
      "store/watch.webp",
      "store/search.webp",
      "store/channel.webp",
      "store/phone.webp"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "npm run build:agent && npm run generate && vp build",
    "build:agent": "vp build -c vite.agent.config.ts",
    "build:npm": "npm run build:agent && npm run generate && vp build -c vite.npm.config.ts && node scripts/write-npm-manifest.mjs && node scripts/check-npm-package.mjs",
    "dev": "npm run build:agent && npm run generate && vp dev --port 4561",
    "generate": "graphql-codegen --config codegen.ts",
    "lint": "vp lint src tests functions",
    "postinstall": "patch-package",
    "store-art": "node scripts/store-art.mjs",
    "test": "npm run build:agent && vp test run tests/unit",
    "test:browser": "playwright test --project=chromium",
    "test:browser:webkit": "playwright test --project=webkit tests/browser/muxer-playback.spec.ts tests/browser/undo.spec.ts",
    "type-check": "npm run generate && tsc --noEmit"
  },
  "dependencies": {
    "@banou/ponyfill": "^0.0.17",
    "@banou/social": "^0.0.6",
    "@bufbuild/protobuf": "2.12.1",
    "@emotion/react": "^11.14.0",
    "@fkn/lib": "^0.9.88",
    "@urql/exchange-graphcache": "^9.0.1",
    "bgutils-js": "3.2.0",
    "googlevideo": "4.0.4",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.1",
    "libcurl.js": "0.7.5",
    "lucide-react": "^1.24.0",
    "osra": "^0.6.3",
    "preact": "11.0.0-beta.0",
    "shaka-player": "4.16.37",
    "urql": "^5.0.1",
    "wouter": "^3.7.1",
    "youtubei.js": "18.3.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@playwright/test": "^1.54.2",
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^24.0.0",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plus": "0.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vitest": "4.1.11"
  }
}
